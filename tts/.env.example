# TTS 进程启动前显式导出这些变量；启动方法见 docs/voice-cloning.md。
# 相对路径以 tts/ 为基准；已有外部权重时填写绝对路径，无需复制或下载。
TTS_QWEN_MODEL_PATH=models/Qwen3-TTS-12Hz-0.6B-CustomVoice
TTS_QWEN_DEVICE=cuda:0
TTS_QWEN_DTYPE=bfloat16
TTS_QWEN_MAX_NEW_TOKENS=2048
TTS_QWEN_MAX_TEXT_CHARS=120
TTS_QWEN_HOST_A=vivian
TTS_QWEN_HOST_B=uncle_fu

# Base 与 CustomVoice 在首版中互斥启用；默认均不加载真实模型。
TTS_ENABLE_QWEN=0
TTS_ENABLE_QWEN_BASE=0
TTS_QWEN_BASE_MODEL_PATH=models/Qwen3-TTS-12Hz-0.6B-Base
# 启用 Base 时必须配置以下两项，与生成 API/Worker 完全一致。
# VOICE_REFERENCE_DIR=/absolute/path/to/generation-backend/data/voice-references
# TTS_INTERNAL_TOKEN=replace-with-a-local-random-secret
