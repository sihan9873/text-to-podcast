# 供 scripts/local_services.py 的真实 Qwen TTS 启动使用。
# 相对路径以 tts/ 为基准；已有外部权重时填写绝对路径，无需复制或下载。
TTS_QWEN_MODEL_PATH=models/Qwen3-TTS-12Hz-0.6B-CustomVoice
TTS_QWEN_DEVICE=cuda:0
TTS_QWEN_DTYPE=bfloat16
TTS_QWEN_MAX_NEW_TOKENS=2048
TTS_QWEN_MAX_TEXT_CHARS=120
TTS_QWEN_HOST_A=vivian
TTS_QWEN_HOST_B=uncle_fu
