# 默认可直接启动的 SQLite；切换 MySQL 后重新执行 bootstrap。
DATABASE_URL=sqlite:///data/backend.sqlite3
# MySQL 示例：先创建 textcast 数据库；密码特殊字符须 URL 编码。
# DATABASE_URL=mysql+pymysql://textcast:change-me@127.0.0.1:3306/textcast?charset=utf8mb4

STORAGE_DIR=./data/assets
DEVELOPMENT_USER_ID=1
WORKER_POLL_SECONDS=0.5
WORKER_LEASE_SECONDS=60
MAX_PENDING_TASKS=100
CORS_ORIGIN=http://localhost:5173

# 当前固定 Mock，无需真实 LLM/TTS 密钥；两个生成方法默认各暂停10秒。
# 切换本地 TTS 后，API、Worker、bootstrap 均需使用相同配置并重启。
AUDIO_PROVIDER=local_http
LOCAL_TTS_BASE_URL=http://127.0.0.1:8001
LOCAL_TTS_ENGINE_ID=mock
LOCAL_TTS_TIMEOUT_SECONDS=300
LOCAL_TTS_CHUNK_CHARS=120
LOCAL_TTS_SAMPLE_RATE=24000
LOCAL_TTS_TURN_SILENCE_MS=250
FFMPEG_BINARY=ffmpeg
AUDIO_ENCODE_TIMEOUT_SECONDS=60
