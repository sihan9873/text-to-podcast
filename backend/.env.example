TEXTCAST_DATABASE_PATH=./data/textcast.db
TEXTCAST_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TEXTCAST_SESSION_TTL_SECONDS=28800
TEXTCAST_SECURE_COOKIES=false
TEXTCAST_ALLOW_REGISTRATION=true

# 仅在数据库没有任何用户时创建一次。首次启动后应删除密码配置。
TEXTCAST_BOOTSTRAP_ADMIN_USERNAME=admin
TEXTCAST_BOOTSTRAP_ADMIN_PASSWORD=请替换为至少8位的强密码
TEXTCAST_BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员

# --- 本地 LLM/TTS（由 feat/local-tts-port 从 feat/backend-tts-integration 移植）---
# 注意：当前 integration 的 backend/ 是鉴权后端；下列配置供后续接线，或迁移到 generation-backend 使用。
# 默认先用 mock；联调本地服务时再改为 local_http。
LLM_PROVIDER=mock
LOCAL_LLM_BASE_URL=http://127.0.0.1:8002
LOCAL_LLM_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
LOCAL_LLM_TIMEOUT_SECONDS=300
LOCAL_LLM_MAX_NEW_TOKENS=1536

AUDIO_PROVIDER=mock
LOCAL_TTS_BASE_URL=http://127.0.0.1:8001
LOCAL_TTS_ENGINE_ID=qwen3-customvoice
LOCAL_TTS_TIMEOUT_SECONDS=300
LOCAL_TTS_CHUNK_CHARS=120
LOCAL_TTS_SAMPLE_RATE=24000
LOCAL_TTS_TURN_SILENCE_MS=250
FFMPEG_BINARY=ffmpeg
AUDIO_ENCODE_TIMEOUT_SECONDS=60
